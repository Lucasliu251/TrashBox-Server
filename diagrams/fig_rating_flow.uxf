   (每日评分 + 区间汇总评分)</panel_attributes><additional_attributes></additional_attributes></element><element><id>Relation</id><coordinates><x>399</x><y>539</y><w>140</w><h>21</h></coordinates><panel_attributes>lt=&lt;&lt;-</panel_attributes><additional_attributes>10;15;180;15</additional_attributes></element><element><id>UMLClass</id><coordinates><x>518</x><y>609</y><w>203</w><h>98</h></coordinates><panel_attributes>计算示例
